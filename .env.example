# Copy to .env.local and fill in. Never commit real values.
# Local values: run `npm run db:start` (or `npx supabase status`) and copy
# the API URL and the publishable key.

# Browser-safe (shipped to the client). Publishable key only, never a secret key.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-key
