    "db:lint": "supabase db lint --local",
    "db:types": "supabase gen types typescript --local --schema public > src/types/database.types.ts && prettier --write --log-level warn src/types/database.types.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
